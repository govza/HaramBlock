# WXT Submit Configuration
# Copy this file to .env.submit and fill in your credentials
# NEVER commit .env.submit to version control!

# Chrome Web Store
# Get credentials: https://wxt.dev/guide/essentials/publishing.html#chrome-web-store
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Firefox Add-on Store
# Get credentials: https://wxt.dev/guide/essentials/publishing.html#firefox-addon-store
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=

# Edge Add-ons
# Get credentials: https://wxt.dev/guide/essentials/publishing.html#edge-addon-store
EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=
