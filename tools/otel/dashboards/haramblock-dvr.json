{
  "uid": "haramblock-dvr",
  "title": "HaramBlock DVR",
  "description": "Video session + DVR health, inference latency, anomaly dumps and umbrella traces for the HaramBlock extension (dev builds only).",
  "tags": ["haramblock", "dvr", "telemetry"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "session",
        "label": "VideoSession",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hb_dvr_captured_fps, hb_session_id)",
          "refId": "sessions"
        },
        "definition": "label_values(hb_dvr_captured_fps, hb_session_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "DVR anomalies",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "{service_name=\"haramblock\"} |= \"video.dvr.anomaly\"",
        "titleFormat": "video.dvr.anomaly",
        "textFormat": "{{hb_dvr_anomaly_id}}"
      },
      {
        "name": "D raised",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "{service_name=\"haramblock\"} |= \"video.dvr.delay_raised\"",
        "titleFormat": "video.dvr.delay_raised",
        "textFormat": "{{hb_dvr_from_sec}} -> {{hb_dvr_to_sec}} ({{hb_dvr_cause}})"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "DVR (per VideoSession)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Captured vs presented fps",
      "description": "Per 1 s window. Presented < 0.75 x captured for 2 s triggers a video.dvr.anomaly dump.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hb_dvr_captured_fps{hb_session_id=~\"$session\"}",
          "legendFormat": "{{hb_session_id}} captured ({{hb_dvr_store}}/{{hb_dvr_tap}})",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "hb_dvr_presented_fps{hb_session_id=~\"$session\"}",
          "legendFormat": "{{hb_session_id}} presented",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Frame repeat ratio",
      "description": "Share of presented ticks that re-served the previous frame.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hb_dvr_frame_repeat_ratio{hb_session_id=~\"$session\"}",
          "legendFormat": "{{hb_session_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "D (delay) over time",
      "description": "DVR delay D. Steps up on video.dvr.delay_raised (cause verdict|store_stall).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hb_dvr_delay_sec{hb_session_id=~\"$session\"}",
          "legendFormat": "{{hb_session_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ring bytes / span",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hb_dvr_ring_bytes{hb_session_id=~\"$session\"}",
          "legendFormat": "{{hb_session_id}} bytes",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "hb_dvr_ring_span_sec{hb_session_id=~\"$session\"}",
          "legendFormat": "{{hb_session_id}} span (s)",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "heatmap",
      "title": "Capture time (ms)",
      "description": "Per-tick frame capture cost (hb.dvr.capture_ms).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "options": {
        "calculate": false,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "yAxis": {
          "unit": "ms",
          "axisPlacement": "left"
        },
        "cellGap": 1,
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(hb_dvr_capture_ms_bucket{hb_session_id=~\"$session\"}[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Present time (ms)",
      "description": "Per-tick present cost (hb.dvr.present_ms).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "options": {
        "calculate": false,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "yAxis": {
          "unit": "ms",
          "axisPlacement": "left"
        },
        "cellGap": 1,
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(hb_dvr_present_ms_bucket{hb_session_id=~\"$session\"}[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Main-thread long tasks",
      "description": "PerformanceObserver longtask entries while any DVR presents. > 100 ms during playback triggers an anomaly dump.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(hb_main_thread_long_task_ms_count{hb_session_id=~\"$session\"}[$__rate_interval]))",
          "legendFormat": "long tasks",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum(rate(hb_main_thread_long_task_ms_bucket{hb_session_id=~\"$session\"}[$__rate_interval])) by (le))",
          "legendFormat": "p90 duration (ms)",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "DVR anomaly dumps",
      "description": "video.dvr.anomaly headers plus their video.dvr.tick records (last 5 s per dump, one dump per 10 s per session). Expand a line for hb.dvr.tick.* and the trace_id link.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"haramblock\"} |~ \"video\\\\.dvr\\\\.(anomaly|tick)\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Session + DVR events",
      "description": "video.session.transition, video.dvr.start/stop/delay_raised/underrun/store_demoted/budget_*, video.audio.route, video.capture.failed.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 9
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"haramblock\"} |~ \"video\\\\.(session|dvr|audio|capture)\\\\.\" != \"video.dvr.tick\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Inference",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Inference round-trip (content) p50 / p90",
      "description": "inference.roundtrip span duration as seen by the content script.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(hb_inference_roundtrip_ms_bucket{}[$__rate_interval])) by (le, hb_media_kind))",
          "legendFormat": "p50 {{hb_media_kind}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum(rate(hb_inference_roundtrip_ms_bucket{}[$__rate_interval])) by (le, hb_media_kind))",
          "legendFormat": "p90 {{hb_media_kind}}",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Inference run (background) p50 / p90",
      "description": "decode + preprocess + session.run per task.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(hb_inference_run_duration_milliseconds_bucket{}[$__rate_interval])) by (le, hb_media_kind))",
          "legendFormat": "p50 {{hb_media_kind}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum(rate(hb_inference_run_duration_milliseconds_bucket{}[$__rate_interval])) by (le, hb_media_kind))",
          "legendFormat": "p90 {{hb_media_kind}}",
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Inference requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(hb_inference_requests_total[$__rate_interval])) by (hb_media_kind, hb_status)",
          "legendFormat": "{{hb_media_kind}} {{hb_status}}",
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Inference queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 5000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hb_inference_queue_depth",
          "legendFormat": "queue depth",
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "table",
      "title": "video.session umbrella traces",
      "description": "One trace per VideoSession; video.dvr.warmup spans hang under it. Click a trace id to open it in Tempo; round-trips link to it via hb.session.trace_id.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 9
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"haramblock\" && name=\"video.session\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Slow inference round-trips (> 500 ms)",
      "description": "inference.roundtrip traces whose root span exceeded 500 ms.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 9
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"haramblock\" && name=\"inference.roundtrip\" && duration > 500ms}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}
