# Copy to .env. Read by wxt.config.ts at build time (WXT_ prefix).
#
# WXT_CLOUD_PREDICTIONS_URL and WXT_CLOUD_PREDICTIONS_REPORT are not set here: they live in the committed .env.development
# and .env.production. A mode file wins over .env and .env.local, so override them in
# .env.development.local or .env.production.local (or a non-empty process environment value).

# OTLP/HTTP collector for dev-build telemetry (pnpm otel:up starts one on this port).
# Set to an empty string to compile telemetry export out of the dev build.
WXT_OTEL_ENDPOINT=http://localhost:4318
