# Committed defaults for `pnpm build` / `pnpm zip`. Holds no secrets; override in .env.production.local.

# The Shared Prediction Cache (Diwan). Required, and must be https:// outside a dev build.
WXT_CLOUD_PREDICTIONS_URL=https://api.haramblock.com

# "false" stops this build reporting (lookups stay). Set it while running unshipped inference changes.
WXT_CLOUD_PREDICTIONS_REPORT=true
