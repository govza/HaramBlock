{
  "name": "haram-block",
  "description": "Gaze protection — blocks and filters inappropriate content, keeping you focused",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Rasul Abu Muhammad Amin",
    "email": "admin@haramblock.com",
    "url": "https://haramblock.com"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/govza/HaramBlock.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b firefox",
    "submit:init": "wxt submit init",
    "submit": "wxt submit --chrome-zip .output/haram-block-*-chrome.zip --firefox-zip .output/haram-block-*-firefox.zip --firefox-sources-zip .output/haram-block-*-sources.zip",
    "submit:chrome": "wxt submit --chrome-zip .output/haram-block-*-chrome.zip",
    "submit:firefox": "wxt submit --firefox-zip .output/haram-block-*-firefox.zip --firefox-sources-zip .output/haram-block-*-sources.zip",
    "submit:dry-run": "wxt submit --dry-run --chrome-zip .output/haram-block-*-chrome.zip --firefox-zip .output/haram-block-*-firefox.zip --firefox-sources-zip .output/haram-block-*-sources.zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:unit": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint",
    "fix": "pnpm run format && pnpm run lint:fix",
    "check:parallel": "pnpm run --parallel format:check lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": ["prettier --write", "eslint --fix"],
    "*.{json,md,css,html}": ["prettier --write"]
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@wxt-dev/i18n": "^0.2.4",
    "comctx": "^1.4.3",
    "consola": "^3.4.2",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "js-yaml": "^4.1.0",
    "p-queue": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "type-fest": "^4.41.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
