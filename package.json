{
  "name": "haram-block",
  "description": "Gaze protection — blocks and filters inappropriate content, keeping you focused",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "author": {
    "name": "Rasul Abu Muhammad Amin",
    "email": "admin@haramblock.com",
    "url": "https://haramblock.com"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/govza/HaramBlock.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:no-gpu": "cross-env NO_GPU=true wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b firefox",
    "submit:init": "wxt submit init",
    "submit": "wxt submit --chrome-zip .output/haram-block-*-chrome.zip --firefox-zip .output/haram-block-*-firefox.zip --firefox-sources-zip .output/haram-block-*-sources.zip --edge-zip .output/haram-block-*-chrome.zip",
    "submit:chrome": "wxt submit --chrome-zip .output/haram-block-*-chrome.zip",
    "submit:firefox": "wxt submit --firefox-zip .output/haram-block-*-firefox.zip --firefox-sources-zip .output/haram-block-*-sources.zip",
    "submit:edge": "wxt submit --edge-zip .output/haram-block-*-chrome.zip",
    "submit:dry-run": "wxt submit --dry-run --chrome-zip .output/haram-block-*-chrome.zip --firefox-zip .output/haram-block-*-firefox.zip --firefox-sources-zip .output/haram-block-*-sources.zip --edge-zip .output/haram-block-*-chrome.zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:unit": "vitest",
    "bench": "node scripts/benchmark/run.mjs",
    "e2e": "wdio run ./tests/e2e/config/wdio.browser.conf.ts",
    "e2e:firefox": "cross-env IS_FIREFOX=true wdio run ./tests/e2e/config/wdio.browser.conf.ts",
    "e2e:android": "wdio run ./tests/e2e/config/wdio.android.conf.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint",
    "fix": "pnpm run format && pnpm run lint:fix",
    "check:parallel": "pnpm run --parallel format:check lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@wxt-dev/i18n": "^0.2.5",
    "comctx": "^1.6.1",
    "consola": "^3.4.2",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "js-yaml": "^4.2.0",
    "onnxruntime-web": "^1.26.0",
    "p-queue": "^9.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@wdio/cli": "9.27.2",
    "@wdio/cucumber-framework": "^9.27.2",
    "@wdio/globals": "9.27.2",
    "@wdio/local-runner": "9.27.2",
    "@wdio/spec-reporter": "9.27.2",
    "@wdio/types": "9.27.2",
    "@webgpu/types": "^0.1.70",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  },
  "pnpm": {
    "overrides": {
      "publish-browser-extension": "^4.0.0",
      "@vitejs/plugin-react": "^6.0.2"
    }
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
